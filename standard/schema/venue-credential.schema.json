{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://heropad.supervictoruniverse.com/standard/schema/venue-credential.schema.json",
  "title": "Venue Credential (ovc/0.1)",
  "description": "Off-chain metadata of a collectible issued by a physical venue. Metaplex layout plus a `credential` object.",
  "type": "object",
  "required": ["name", "image", "credential"],
  "properties": {
    "name": { "type": "string", "minLength": 1, "maxLength": 64 },
    "symbol": { "type": "string", "maxLength": 10 },
    "description": { "type": "string", "maxLength": 1000 },
    "image": { "type": "string", "format": "uri", "pattern": "^https://" },
    "external_url": { "type": "string", "format": "uri", "pattern": "^https://" },
    "attributes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["trait_type", "value"],
        "properties": {
          "trait_type": { "type": "string", "maxLength": 40 },
          "value": { "type": ["string", "number"], "maxLength": 80 }
        }
      }
    },
    "credential": {
      "type": "object",
      "required": ["standard", "type", "issuer", "issued_at"],
      "properties": {
        "standard": { "type": "string", "pattern": "^ovc/0\\.[0-9]+$" },
        "type": { "enum": ["stamp_card", "tier", "limited_edition", "visit", "event"] },
        "issuer": {
          "type": "object",
          "required": ["id", "name"],
          "properties": {
            "id": { "type": "string", "pattern": "^[a-z0-9]([a-z0-9-]*[a-z0-9])?(\\.[a-z0-9]([a-z0-9-]*[a-z0-9])?)+$", "maxLength": 253 },
            "name": { "type": "string", "minLength": 1, "maxLength": 80 },
            "url": { "type": "string", "format": "uri", "pattern": "^https://" },
            "location": { "type": "string", "maxLength": 80 }
          },
          "additionalProperties": false
        },
        "issued_at": { "type": "string", "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$" },
        "tier": {
          "type": "object",
          "required": ["level", "label"],
          "properties": {
            "level": { "type": "integer", "minimum": 1 },
            "label": { "type": "string", "minLength": 1, "maxLength": 40 }
          },
          "additionalProperties": false
        },
        "edition": {
          "type": "object",
          "required": ["serial"],
          "properties": {
            "serial": { "type": "integer", "minimum": 1 },
            "of": { "type": "integer", "minimum": 1 }
          },
          "additionalProperties": false
        },
        "physical": {
          "type": "object",
          "required": ["kind", "ref"],
          "properties": {
            "kind": { "enum": ["figurine", "pin", "card", "tag", "ticket", "other"] },
            "ref": { "type": "string", "minLength": 1, "maxLength": 64 }
          },
          "additionalProperties": false
        },
        "platform": {
          "type": "object",
          "required": ["name"],
          "properties": {
            "name": { "type": "string", "minLength": 1, "maxLength": 40 },
            "url": { "type": "string", "format": "uri", "pattern": "^https://" }
          },
          "additionalProperties": false
        },
        "note": { "type": "string", "maxLength": 200 }
      },
      "allOf": [
        { "if": { "properties": { "type": { "const": "tier" } } }, "then": { "required": ["tier"] } },
        { "if": { "properties": { "type": { "const": "limited_edition" } } }, "then": { "required": ["edition"] } }
      ]
    }
  }
}
