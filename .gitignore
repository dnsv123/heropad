# =============================================================================
# HeroPad — .gitignore
# Anything here NEVER reaches GitHub. Review before adding to ignore list:
# if a file should be tracked but excluded for one user, use .git/info/exclude.
# =============================================================================

# Dependencies
node_modules/
.pnp
.pnp.js
.yarn/
.pnpm-store/

# Environment variables — NEVER commit (.env.example IS tracked, has placeholders only)
.env
.env.local
.env.development
.env.test
.env.production
.env.staging
.env.*.local
.envrc

# Build output
dist/
build/
out/
.next/
.nuxt/
.cache/
.parcel-cache/

# Vercel / Railway / hosting metadata
.vercel/
.railway/
.netlify/

# Turbo / Nx caches
.turbo/
.nx/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Coverage
coverage/
*.lcov
.nyc_output/

# Editors / OS
.DS_Store
Thumbs.db
*.swp
*.swo
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json.example

# Testing
*.test.local
playwright-report/
test-results/

# TypeScript build info
*.tsbuildinfo

# =============================================================================
# Cryptographic material — DOUBLE PARANOIA
# Anything that even LOOKS like a key, secret, or seed.
# =============================================================================

# Solana / generic crypto keypairs
keypairs/
*.keypair.json
*.solana-keypair
id.json
id_*.json

# Generic secrets / certs
secrets/
.secrets/
*.pem
*.key
*.p12
*.pfx
*.crt
*.cer
*.kdbx
seedphrase*.txt
mnemonic*.txt
private*.txt

# AWS / GCP / generic cloud creds
.aws/
.gcloud/
service-account*.json
credentials.json

# AI assistant cache (some IDEs leak project context here)
.cursor/
.aider*
.claude/
.copilot-cache/

# =============================================================================
# Private working files — NEVER on GitHub.
# Internal docs, scratch notes, large binary assets, deck source PPTX,
# anything that shouldn't be visible to hackathon judges or the public.
# =============================================================================
_private/
.private/
docs/internal/
docs/_*.md

# =============================================================================
# Misc
# =============================================================================
.eslintcache
.stylelintcache
.firebase/
tmp/
temp/
*.private
*.local
*.bak
*.orig

# Test claim codes + their HMAC signatures — never tracked (they are bearer credentials).
codes
