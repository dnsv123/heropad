# =============================================================================
# HeroPad — environment variables
# Copy to `.env` for local development. NEVER commit `.env`.
# Production values live in Vercel (web) and Railway (api) — not in the repo.
# =============================================================================

# ------------------------------ Web (Vite) -----------------------------------
# Public Privy app id (safe to expose).
VITE_PRIVY_APP_ID=
# Where the web app calls the API. Local: http://localhost:8787
VITE_API_BASE_URL=http://localhost:8787
# Explorer links: "devnet" | "mainnet-beta". Defaults to devnet when unset.
VITE_SOLANA_CLUSTER=devnet

# ------------------------------ API (Railway) --------------------------------
PORT=8787
# Comma-separated browser origins allowed by CORS.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Supabase — the service-role key bypasses RLS: server only.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Privy — server-side token verification (dashboard → App secret, shown once).
PRIVY_APP_ID=
PRIVY_APP_SECRET=
# Privy user ids (did:privy:...) allowed into /admin, comma-separated.
ADMIN_PRIVY_IDS=

# Solana — the RPC decides the cluster (Helius URL for devnet or mainnet).
SOLANA_RPC_URL=
# Admin keypair that pays for and signs trophy mints (base58 or JSON array).
# Generate offline; paste only into Railway, never into chat or a client bundle.
SOLANA_ADMIN_PRIVATE_KEY=
# Bubblegum tree the trophies are minted into (falls back to the DB row).
BUBBLEGUM_TREE_ADDRESS=
# Metadata JSON for the card-completion trophy.
TROPHY_METADATA_URI=https://heropad.supervictoruniverse.com/cnft/trophy.json

# Figurine claim codes are HMAC-signed with this (≥32 chars).
HMAC_SECRET=

# Anti-abuse caps (defaults in code when unset).
LOYALTY_DAILY_CAP=15
TROPHY_DAILY_CAP=50
TROPHY_GLOBAL_DAILY_CAP=300
REFERRAL_DAILY_CAP=20

# BITS (loyalty points) per event.
STAMP_BITS_REWARD=10
TROPHY_BITS_REWARD=100
REFERRAL_BITS_INVITER=50
REFERRAL_BITS_FRIEND=25

# Invoicing via Oblio (Romanian e-invoicing). Dry run unless OBLIO_DRY_RUN=0.
OBLIO_EMAIL=
OBLIO_SECRET=
OBLIO_CIF=
OBLIO_SERIES=
OBLIO_DRY_RUN=1
OBLIO_VAT_NAME=Normala
OBLIO_PRICE_INCLUDES_VAT=1
OBLIO_UNIT=buc
# Shared with the GitHub Actions cron that triggers monthly invoicing.
BILLING_CRON_SECRET=
