# =============================================================================
# HeroPad — environment variables template
# Copy this file to `.env` and fill in real values. NEVER commit `.env`.
# =============================================================================

# -------------------- Frontend (Vite-exposed, prefix VITE_) ------------------
# Public Privy app id (safe to expose)
VITE_PRIVY_APP_ID=

# Public Supabase URL + anon key (safe to expose with RLS enabled)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Public Solana RPC (Helius devnet recommended)
VITE_SOLANA_RPC_URL=

# Backend API base URL — read by the frontend ClaimFlow.
# Local dev: http://localhost:8787
# Prod: https://api.heropad.supervictornft.com (or wherever you host the API)
VITE_API_BASE_URL=http://localhost:8787

# -------------------- Backend (server-only, NEVER expose) --------------------
# Supabase service role key — bypasses RLS, server-only
SUPABASE_SERVICE_ROLE_KEY=

# Solana admin keypair private key (base58 or JSON array string).
# Generate offline. NEVER paste into chat or any client-side bundle.
SOLANA_ADMIN_PRIVATE_KEY=

# Privy server-side token verification (dashboard → API keys → App secret).
# Shown ONCE at creation — copy it immediately. Required by /api/loyalty.
PRIVY_APP_SECRET=

# HMAC secret for signing claim payloads / QR codes
HMAC_SECRET=

# JWT secret for backend session tokens
JWT_SECRET=

# Backend public URL (used by frontend to call API). Example: http://localhost:8787
API_BASE_URL=
