# ============================================================
# .npmrc - Supply Chain Security Rules
# Created: 2026-05-13 (post TanStack incident)
# ============================================================

# Cooldown 7 zile - blocheaza pachete proaspat publicate (atacuri tipic <24h)
min-release-age=7d

# Blocheaza dependencies din Git URLs (vectorul atacului TanStack)
allow-git=none

# Nota: ignore-scripts NU e activat. Multe pachete legitime (Vite/esbuild,
# sharp, @swc/core) au nevoie de postinstall pentru binare native.
# Compensam prin min-release-age + audit + monitorizare manuala.

# Audit la fiecare install
audit=true
audit-level=moderate

# Lockfile enforcement
package-lock=true
